{
  "enabled": true,
  "quick": "make quick",
  "format": "case {file} in *.rs) rustfmt --edition 2021 {file} ;; esac",
  "fast": "make fast",
  "full": "make full",
  "scans": {
    "secrets": "make secrets-branch",
    "sast": "make sast",
    "deps": "make audit",
    "iac": "zizmor .github/workflows"
  },
  "skip_paths": [
    "*.md",
    "docs/*"
  ]
}
